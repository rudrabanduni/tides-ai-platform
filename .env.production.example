# TIDES-AI Production Environment Template (No Live Secrets)
# Copy this file to your production secrets manager / runtime environment and populate
# DATABASE_URL, JWT_SECRET_KEY, and ANTHROPIC_API_KEY via encrypted secret injection.

APP_NAME=TIDES AI Startup Evaluation Platform
APP_ENV=production
DEBUG=false
DEV_MODE=false
API_V1_PREFIX=/api/v1

# Explicitly configured non-SQLite production database required when APP_ENV=production
DATABASE_URL=postgresql+psycopg://tides_prod:CHANGE_ME_STRONG_DB_PASSWORD@db.example.internal:5432/tides_ai_prod

# Authentication & Session Signing (Generate >=32-char cryptographically random secret)
JWT_SECRET_KEY=CHANGE_ME_GENERATE_CRYPTOGRAPHIC_RANDOM_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Storage & Upload Controls
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25
CORS_ORIGINS=https://app.example.com

# Live AI Provider Controls (Fail-Closed: no mock fallback in production)
AI_ENABLED=true
AI_PROVIDER=anthropic
AI_FAST_MODEL=claude-haiku-5-5
AI_REASONING_MODEL=claude-sonnet-5-5
LITELLM_MODEL=claude-sonnet-5-5
AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=0

# Controlled Budget & Currency Guardrails ($0.35 USD ceiling, ₹96/USD, 1.18x buffer)
AI_MAX_EVALUATION_BUDGET_USD=0.35
AI_MAX_EVALUATION_BUDGET=0.35
AI_INR_EXCHANGE_RATE=96.0
AI_INR_BUFFER_MULTIPLIER=1.18
AI_PRICING_CATALOG_VERSION=2026-10-v3
AI_DEFAULT_CACHE_WRITE_TTL=5m
AI_CACHE_PRICING_POLICY=conservative_1h

# External Research Controls (Disabled unless explicitly funded and enabled)
RESEARCH_PROVIDER=disabled
TAVILY_API_KEY=

# Provider Credentials (MUST be injected at runtime; NEVER commit real keys)
ANTHROPIC_API_KEY=
